import time

class SimuladorDriverImpresora:
    def __init__(self, puerto_conexion: str):
        self.puerto = puerto_conexion
        self.conectada = False
        # Comandos de bajo nivel simulados (Estilo ESC/P de Epson)
        self.ESC_INIT = b'\x1b\x40'       # Inicializa la impresora
        self.ESC_BOLD_ON = b'\x1b\x45\x01' # Activa texto en negrita
        self.ESC_BOLD_OFF = b'\x1b\x45\x00'# Desactiva texto en negrita
        self.ESC_CUT = b'\x1d\x56\x00'    # Comando de corte de papel

    def conectar(self):
        """Simula la negociación de hardware (Handshake) con el puerto"""
        print(f"[DRIVER] Buscando dispositivo en el puerto {self.puerto}...")
        time.sleep(1)  # Simula latencia de hardware
        self.conectada = True
        print("[DRIVER] Conexión establecida. Impresora lista.")

    def _traducir_a_lenguaje_impresora(self, texto: str, negrita: bool) -> bytes:
        """Pasarela de traducción (Traducción de formato a bytes de bajo nivel)"""
        buffer_datos = bytearray()
        
        # 1. Enviar comando de inicialización
        buffer_datos.extend(self.ESC_INIT)
        
        # 2. Aplicar formato si es necesario
        if negrita:
            buffer_datos.extend(self.ESC_BOLD_ON)
            
        # 3. Convertir el texto plano a bytes codificados (ASCII/UTF-8)
        buffer_datos.extend(texto.encode('utf-8'))
        
        # 4. Apagar formato y añadir salto de línea
        if negrita:
            buffer_datos.extend(self.ESC_BOLD_OFF)
        buffer_datos.extend(b'\n')
        
        # 5. Enviar comando físico de corte de papel
        buffer_datos.extend(self.ESC_CUT)
        
        return bytes(buffer_datos)

    def enviar_trabajo_impresion(self, texto_documento: str, usar_negrita: bool = False):
        """Envía el buffer de datos binarios a la cola del hardware"""
        if not self.conectada:
            raise ConnectionError("[DRIVER] Error 0x01: Impresora no conectada.")
        
        print("\n[DRIVER] Procesando documento...")
        # El driver traduce el contenido a código binario de impresora
        datos_binarios = self._traducir_a_lenguaje_impresora(texto_documento, usar_negrita)
        
        print(f"[DRIVER] Enviando {len(datos_binarios)} bytes al puerto {self.puerto}...")
        time.sleep(1.5) # Simula la velocidad de transferencia del bus
        
        print("[HARDWARE IMPRESORA] Datos binarios recibidos en el búfer:")
        print(f"  {datos_binarios}")
        print("[HARDWARE IMPRESORA] ¡Impresión completada con éxito!")

# --- PRUEBA DEL CONTROLADOR ---
if __name__ == "__main__":
    # 1. Se instancia el driver asignándole un puerto físico (USB / COM)
    mi_driver = SimuladorDriverImpresora(puerto_conexion="USB001")
    
    # 2. El sistema operativo conecta el dispositivo
    mi_driver.conectar()
    
    # 3. Una aplicación (como Word o un PDF) envía un texto a imprimir
    mi_driver.enviar_trabajo_impresion("¡Hola Mundo! Este es mi primer driver.", usar_negrita=True)
